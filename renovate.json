{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>teamony-labs/renovate-config"],
  "baseBranchPatterns": ["staging"],
  "prCreation": "not-pending",
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "Group Cloudflare deployment tooling into a single PR",
      "matchPackageNames": ["wrangler", "@cloudflare/workers-types"],
      "groupName": "cloudflare tooling"
    }
  ]
}
